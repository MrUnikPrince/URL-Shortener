<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <style>
        :root {
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --danger: #dc2626;
    --danger-hover: #b91c1c;
    --success: #10b981;
    --success-hover: #059669;
    --background: #f8fafc;
    --text: #1e293b;
    --muted: #64748b;
    --radius: 8px;
    --shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

body {
    background: #f5f5f5;
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    padding: 2rem;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: var(--shadow);
}

h1 {
    color: var(--primary);
    margin-bottom: 2rem;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    text-align: center;
}

.form-group {
    display: flex;
    flex-wrap: wrap; /* Allow wrapping for smaller screens */
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: stretch;
}

input[type="url"], 
input[type="text"],
.expiry-select {
    flex: 1; /* Adjust flex to make inputs responsive */
    padding: 0.8rem;
    border: 2px solid #e5e7eb;
    border-radius: var(--radius);
    font-size: 1rem;
    transition: all 0.3s ease;
    background: white;
}

button {
    flex: 0 0 auto; /* Prevent button from stretching */
    padding: 0.8rem 1.5rem;
    border: none;
    border-radius: var(--radius);
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

button:active {
    transform: scale(0.98);
}

.primary-btn {
    background: var(--primary);
    color: white;
}

.primary-btn:hover {
    background: var(--primary-hover);
}

button[type="submit"] {
    background: var(--primary);
    color: white;
    font-weight: bold;
    border: none;
    border-radius: var(--radius);
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
}

button[type="submit"]:hover {
    background: var(--primary-hover);
}

button[type="submit"]:active {
    transform: scale(0.98);
}

@media (max-width: 768px) {
    button[type="submit"] {
        width: 100%; /* Make the button full width on tablets */
        justify-content: center;
    }
}

.url-list {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.url-item {
    background: var(--background);
    padding: 1rem;
    border-radius: var(--radius);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.url-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.short-url a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    word-break: break-all;
}

.short-url a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
}

.stats {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
}

.error {
    background: #fee2e2;
    color: var(--danger);
    padding: 1rem;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
    border: 1px solid #fca5a5;
    animation: slideIn 0.3s ease;
}

.actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
}

.delete-btn {
    background: var(--danger);
    color: white;
}

.delete-btn:hover {
    background: var(--danger-hover);
}

.copy-btn {
    background: var(--primary);
}

.copy-btn:hover {
    background: var(--primary-hover);
}

.qr-btn {
    background: var(--success);
}

.qr-btn:hover {
    background: var(--success-hover);
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    padding: 1rem;
}

.modal-content {
    background: white;
    margin: auto;
    padding: 1.5rem;
    max-width: 400px;
    border-radius: 16px;
    position: relative;
    top: 50%;
    transform: translateY(-50%);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.qr-container {
    padding: 1rem;
    background: white;
    border-radius: 12px;
    margin: 0 auto;
    width: fit-content;
}

.close {
    color: var(--muted);
    font-size: 1.5rem;
    cursor: pointer;
    transition: color 0.2s ease;
}

.close:hover {
    color: var(--text);
}

@media (max-width: 640px) {
    body {
        padding: 1rem;
    }
    
    .container {
        padding: 1.5rem;
    }
    
    .form-group {
        flex-direction: column;
    }
    
    .url-item {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .actions {
        width: 100%;
        flex-wrap: wrap;
    }
    
    .actions button {
        flex: 1;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .form-group {
        flex-direction: column; /* Stack inputs and button vertically on tablets */
    }

    button {
        width: 100%; /* Make the button full width */
        justify-content: center;
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
    </style>
</head>
<body>
    <div class="container">
        <h1>🔗 URL Shortener</h1>
        
        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>

        <form action="/shorten" method="POST">
            <div class="form-group">
                <input type="url" name="fullUrl" placeholder="Paste your long URL here" required>
                <input type="text" 
                       name="customCode" 
                       placeholder="Custom code (uppercase only)"
                       pattern="[A-Z0-9_-]{3,20}"
                       title="3-20 uppercase letters, numbers, underscores, or hyphens">
                <select name="expiration" class="expiry-select">
                    <option value="">No expiration</option>
                    <option value="1">1 Hour</option>
                    <option value="24">1 Day</option>
                    <option value="168">1 Week</option>
                    <option value="720">30 Days</option>
                </select>
                <button type="submit">Shorten</button>
            </div>
        </form>

        <% if (shortUrls.length) { %>
            <div class="url-list">
                <h2>Recent Short Links</h2>
                <% shortUrls.forEach(url => { %>
                    <div class="url-item">
                        <div class="url-info">
                            <div class="short-url">
                                <a href="<%= baseUrl %>/<%= url.short %>" target="_blank">
                                    <%= baseUrl %>/<%= url.short %>
                                </a>
                                <div class="stats">
                                    Created <%= url.createdAt.toLocaleDateString() %> • 
                                    <%= url.clicks %> <%= url.clicks === 1 ? 'click' : 'clicks' %>
                                    <% if (url.expiresAt) { %>
                                        • Expires <%= url.expiresAt.toLocaleString() %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="actions">
                            <button class="copy-btn" onclick="copyUrl('<%= url.short %>')">Copy</button>
                            <button class="qr-btn" onclick="generateQR('<%= url.short %>')">QR Code</button>
                            <button class="delete-btn" onclick="confirmDelete('<%= url.short %>')">Delete</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p>No shortened URLs yet. Create your first one above! 🚀</p>
            </div>
        <% } %>
        
        <footer>
            <p>Made with ❤️ by Prince</p>
        </footer>
    </div>

    <div id="qrModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Share & QR Code</h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <div class="qr-wrapper">
                    <div id="qrCode" class="qr-container"></div>
                </div>
                <div class="share-section">
                    <p class="share-text">Share this link:</p>
                    <div class="share-buttons">
                        <button class="share-btn" onclick="handleShare('<%= baseUrl %>/${currentShortCode}')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/>
                            </svg>
                            Share
                        </button>
                        <button class="copy-link-btn" onclick="copyUrl('${currentShortCode}')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M8 4v12h12V4H8zM6 2h16v16H6V2zM4 6H2v18h18v-2"/>
                            </svg>
                            Copy Link
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
    function confirmDelete(shortCode) {
        if (confirm('Are you sure you want to delete this short URL?\nThis action cannot be undone.')) {
            deleteUrl(shortCode);
        }
    }

    async function deleteUrl(shortCode) {
        try {
            const response = await fetch(`/${shortCode}`, {
                method: 'DELETE'
            });
            
            if (response.ok) {
                window.location.reload(); // Refresh to show updated list
            } else {
                alert('Failed to delete URL');
            }
        } catch (error) {
            console.error('Delete error:', error);
            alert('Error deleting URL');
        }
    }

    function copyUrl(shortCode) {
        const url = `${window.location.origin}/${shortCode}`;
        navigator.clipboard.writeText(url)
            .then(() => alert('URL copied to clipboard!'))
            .catch(() => alert('Failed to copy URL'));
    }

    let currentShortCode = null;
    function generateQR(shortCode) {
        currentShortCode = shortCode;
        const url = `${window.location.origin}/${shortCode}`;
        const qrContainer = document.getElementById('qrCode');
        
        qrContainer.innerHTML = '';
        new QRCode(qrContainer, {
            text: url,
            width: 200,
            height: 200,
            colorDark: "#1f2937",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });
        
        document.getElementById('qrModal').style.display = 'block';
    }

    document.querySelector('.close').onclick = () => {
        document.getElementById('qrModal').style.display = 'none';
        document.getElementById('qrCode').innerHTML = '';
    }

    window.onclick = (event) => {
        if (event.target === document.getElementById('qrModal')) {
            document.getElementById('qrModal').style.display = 'none';
            document.getElementById('qrCode').innerHTML = '';
        }
    }

    // Share Handler
    async function handleShare(url) {
        try {
            if (navigator.share) {
                await navigator.share({
                    title: 'Short URL',
                    text: 'Check out this short URL:',
                    url: url
                });
            } else {
                await navigator.clipboard.writeText(url);
                alert('Link copied to clipboard!');
            }
        } catch (err) {
            console.log('Sharing cancelled', err);
        }
    }
    </script>
</body>
</html>
